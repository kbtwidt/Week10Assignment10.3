<Window x:Class="Week10Assignment10._3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Car Management System"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Car Management System"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Car Input Fields -->
        <GroupBox Header="Car Details"
                  Grid.Row="1"
                  Padding="10"
                  Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Label Content="VIN:" Grid.Row="0"/>
                <TextBox x:Name="txtVIN"
                         Grid.Column="1"
                         Margin="5"/>

                <Label Content="Make:"
                       Grid.Row="0" Grid.Column="2"/>
                <TextBox x:Name="txtMake"
                         Grid.Row="0" Grid.Column="3"
                         Margin="5"/>

                <Label Content="Model:"
                       Grid.Row="1"/>
                <TextBox x:Name="txtModel"
                         Grid.Row="1" Grid.Column="1"
                         Margin="5"/>

                <Label Content="Year:"
                       Grid.Row="1" Grid.Column="2"/>
                <TextBox x:Name="txtYear"
                         Grid.Row="1" Grid.Column="3"
                         Margin="5"/>

                <Label Content="Price:"
                       Grid.Row="2"/>
                <TextBox x:Name="txtPrice"
                         Grid.Row="2" Grid.Column="1"
                         Margin="5"/>

                <Label Content="Color:"
                       Grid.Row="2" Grid.Column="2"/>
                <TextBox x:Name="txtColor"
                         Grid.Row="2" Grid.Column="3"
                         Margin="5"/>
            </Grid>
        </GroupBox>

        <!-- DataGrid and Buttons -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">

                <Button Content="Add"
                        Width="100"
                        Margin="5"
                        Click="Add_Click"/>

                <Button Content="Update"
                        Width="100"
                        Margin="5"
                        Click="Update_Click"/>

                <Button Content="Delete"
                        Width="100"
                        Margin="5"
                        Click="Delete_Click"/>

                <Button Content="Clear"
                        Width="100"
                        Margin="5"
                        Click="Clear_Click"/>

                <Button Content="Refresh"
                        Width="100"
                        Margin="5"
                        Click="Refresh_Click"/>
            </StackPanel>

            <DataGrid x:Name="dgCars"
                      Grid.Row="1"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      SelectionChanged="dgCars_SelectionChanged" Margin="0,10,0,-10"/>
        </Grid>
    </Grid>
</Window>
